[Unit]
Description=Ask about Bo relay (Ollama) for cnpcshangbo.github.io
After=network-online.target

[Service]
WorkingDirectory=%h/ask-about-bo/tools/ai-assistant-ollama
ExecStart=/usr/bin/node %h/ask-about-bo/tools/ai-assistant-ollama/server.mjs
Environment=PORT=8787
Environment=MODEL=gemma4:26b-a4b-it-q8_0
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
